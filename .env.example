# Notchstave — local dev environment template (TZ section 9).
# Copy to .env and fill in placeholder values. NEVER commit a real .env.
#
# Production note, read before touching this file for a deploy: this .env
# mechanism is LOCAL DEV ONLY. In production, ACCOUNT_XPUB and
# INVOICE_INTEGRITY_KEY are delivered via systemd LoadCredential= (or a file
# with 600 perms), never via this file and never as a plain docker-compose
# environment variable — an env var is visible in `docker inspect`,
# `/proc/<pid>/environ`, and core dumps (TZ 5.1, section 9).

ENVIRONMENT=development

# --- Telegram -----------------------------------------------------------
# Bot token from @BotFather. In prod: systemd credentials, per-unit scoped to
# bot (and notifier for outbound delivery), rotated immediately if leaked
# (TZ section 9 runbook: token rotation on suspected compromise).
TELEGRAM_BOT_TOKEN=000000000:AAAA-placeholder-bot-token

# --- PostgreSQL -----------------------------------------------------------
# Used directly by docker-compose.yml and by DATABASE_URL below. Prod: no
# public interface, one role per process with minimal grants (TZ section 9).
POSTGRES_USER=notchstave
POSTGRES_PASSWORD=change-me-local-dev-only
POSTGRES_DB=notchstave
DATABASE_URL=postgresql+psycopg://notchstave:change-me-local-dev-only@localhost:5432/notchstave

# --- Redis ------------------------------------------------------------------
REDIS_PASSWORD=change-me-local-dev-only
REDIS_URL=redis://:change-me-local-dev-only@localhost:6379/0

# --- Celery (notifier delivery queue) ---------------------------------------
CELERY_BROKER_URL=${REDIS_URL}
CELERY_RESULT_BACKEND=${REDIS_URL}

# --- RPC providers (TZ section 5.6) -----------------------------------------
# Three providers per chain: Alchemy and QuickNode as primaries (low latency,
# free tiers cover a portfolio project), Ankr as an independent third
# fallback. Own API keys only — no scraping explorers, no bypassing rate
# limits (TZ section 12).
#
# NOTE on what actually gets read: watcher.config.expand_rpc_url substitutes
# `${VAR}` placeholders inside `chains.rpc_urls` (a DB column, seeded by hand —
# see the runbook below) from the process environment at startup; it never
# reads a `*_BASE_RPC_URL`-shaped variable directly. `ALCHEMY_API_KEY` is the
# one genuinely templated var (`.../v2/${ALCHEMY_API_KEY}`) and covers every
# chain Alchemy serves, unchanged. The `*_BASE_RPC_URL` lines below are the
# resolved shape of that template for reference when writing the `chains` row
# by hand, not variables the code reads by that name — grep the tree before
# assuming otherwise.
ALCHEMY_API_KEY=placeholder-alchemy-key
ALCHEMY_BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/placeholder-alchemy-key
QUICKNODE_BASE_RPC_URL=https://placeholder-endpoint.base-mainnet.quiknode.pro/placeholder-token/
ANKR_BASE_RPC_URL=https://rpc.ankr.com/base/placeholder-ankr-key

# --- Second network: Ethereum mainnet (TZ section 11, Week 4) ---------------
# "Подключается строкой в chains, не переписыванием." Same ALCHEMY_API_KEY
# above authenticates Alchemy's Ethereum endpoint too — only QuickNode and
# Ankr need chain-specific endpoint URLs, the same way they do for Base.
ALCHEMY_ETH_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/placeholder-alchemy-key
QUICKNODE_ETH_RPC_URL=https://placeholder-endpoint.eth-mainnet.quiknode.pro/placeholder-token/
ANKR_ETH_RPC_URL=https://rpc.ankr.com/eth/placeholder-ankr-key
# A second watcher instance (TZ 4: one process per chain) needs its own
# metrics port so it does not collide with the Base watcher on 9102 — see
# observability/prometheus/prometheus.yml's `notchstave-watcher-ethereum` job,
# which already expects this exact value.
WATCHER_METRICS_PORT_ETH=9202
#
# Runbook — enabling Ethereum mainnet is one INSERT, run once against the
# production database (or via settler.tests.conftest.World.chain in a test):
#
#   INSERT INTO chains (chain_id, name, rpc_urls, min_confirmations,
#                        credit_threshold_usd, use_finalized_tag,
#                        last_indexed_block, is_enabled)
#   VALUES (1, 'ethereum-mainnet',
#           ARRAY['https://eth-mainnet.g.alchemy.com/v2/${ALCHEMY_API_KEY}',
#                 '${QUICKNODE_ETH_RPC_URL}',
#                 '${ANKR_ETH_RPC_URL}'],
#           12,    -- deeper than Base's 3: ~12s block time, no shared sequencer
#           20, true, <head_block_at_go_live>, true);
#
# Then: WATCHER_METRICS_PORT=9202 python -m watcher.main --chain-id 1

# --- Account extended public key (xpub) — TZ 5.1 / 5.8-T4 -------------------
# 1) WHAT: the account-level BIP-32 extended PUBLIC key at path m/44'/60'/0'.
#    deriver holds it in memory and derives m/44'/60'/0'/0/i receive addresses
#    from it — no private key ever exists in this system.
# 2) WHY NOT PUBLIC despite the name: whoever holds this xpub can derive every
#    receive address this project will ever use, i.e. read the FULL revenue
#    history and predict all future invoice addresses. Treat it as a secret,
#    not as a public identifier.
# 3) HOW TO GET IT: export OFFLINE, on the owner's hardware wallet, at exactly
#    m/44'/60'/0' (account-level only — never export the master xpub, which
#    would expose every account on every chain). Verify the fingerprint shown
#    by the device matches what deriver reports before trusting it.
# 4) NEVER export it alongside any private key or seed phrase, and never type
#    the seed phrase into this machine to "help" — the two must never be in
#    the same place at the same time.
# 5) PRODUCTION DELIVERY: ONLY via systemd LoadCredential= on
#    notchstave-deriver.service — no other unit gets it. This .env file is
#    LOCAL DEV ONLY; never use it as the xpub source in production.
ACCOUNT_XPUB=xpub-PLACEHOLDER-TEST-VECTOR-ONLY-NEVER-A-REAL-KEY

# --- Invoice integrity HMAC key ----------------------------------------------
# Signs (id, chain_id, asset_id, address, amount_due_raw, expires_at) per
# invoice so a DB-level tamper (e.g. swapped address/amount) is detected
# instead of silently accepted (TZ 5.8/T1.3).
#
# SCOPE, corrected in Week 5: settler, api, bot AND the process that issues
#   invoices. Migration 0006 made that the deriver — see its docstring for the
#   argument, in short that only the component holding the xpub can truthfully
#   promise an address derives from it. So the credential goes on
#   notchstave-deriver.service too, and the earlier note in this file claiming
#   the deriver never sees it is out of date rather than a rule that was
#   broken. The watcher still has no code path that reads it.
# PRODUCTION: systemd credential, not this file, same rule as ACCOUNT_XPUB. The
#   credential is named `notchstave-invoice-integrity-key` and is read from
#   $CREDENTIALS_DIRECTORY, which takes precedence over this variable whenever
#   it is present (core/invoicing/integrity.py::load_integrity_key) — a stray
#   env var cannot downgrade a correctly configured unit.
INVOICE_INTEGRITY_KEY=placeholder-hmac-key-local-dev-only

# --- Invoice issuance policy (TZ 3.1, 5.5, 5.8/T5) ---------------------------
# Same versioning rule as the settler's table below: change any number here and
# bump INVOICING_POLICY_VERSION in the same edit. The version is written into
# invoices.policy_version and into the audit_log row of every issuance, and a
# threshold that moved without the version moving makes every earlier row a lie
# about what it meant (TZ 5.8/T8).
INVOICING_POLICY_VERSION=2026-08-19.invoicing-1
# T5.1 quotas. Both are enforced under a PostgreSQL advisory lock on user_id in
# the same transaction as the INSERT; Redis, if wired, may only reject early and
# never permit (TZ 5.8/T5.1: "сброс или перезапуск Redis не должен открывать
# шлюз").
INVOICING_MAX_ACTIVE_INVOICES_PER_USER=3
INVOICING_MAX_INVOICES_PER_HOUR=10
INVOICING_QUOTA_WINDOW_SECONDS=3600
# T5.4 — a short invoice life is what returns addresses to the pool quickly, so
# consumed index space tracks peak concurrency rather than total clicks. Kept
# equal to the rate lock by default (TZ 5.5), separate knobs because the two
# deadlines protect different parties.
INVOICING_INVOICE_TTL_SECONDS=900
INVOICING_RATE_LOCK_TTL_SECONDS=900
# TZ 5.5 — the top-up window outlives the invoice on purpose: someone who has
# already sent money is in a different position from someone who never paid.
# Also sets the public invoice-page token's TTL (invoice life + this).
INVOICING_TOPUP_WINDOW_SECONDS=86400
# T5.5 behavioural cooldown: N consecutive expired unpaid invoices, then an
# hour off. Soft and self-lifting — one payment resets the streak.
INVOICING_EXPIRED_STREAK_LIMIT=5
INVOICING_COOLDOWN_SECONDS=3600

# --- Admin confirmation key (TZ 3.4, 5.8/T7) ---------------------------------
# WHAT: HMAC key behind the second-message confirmation code that `/resolve
#   credit` demands above ADMIN_MANUAL_CREDIT_LIMIT_USD. The code is a keyed
#   hash of the exact decision (case id, resolution, invoice, amount, operator)
#   plus a coarse time bucket, so a code issued for one case cannot confirm
#   another and expires without a scheduler.
# WHY IT MATTERS: the owner's powers are not "see statistics" — they are
#   crediting an unpaid invoice and opening a refund request. This key is what
#   turns a scripted burst from a captured Telegram session into an interactive
#   exchange the real owner can see happening.
# FAILS CLOSED: unset means a large manual credit is REFUSED, never that it
#   proceeds unconfirmed. Do not "temporarily" leave it empty in production.
# SCOPE: settler only — the settler executes /resolve, the bot merely relays
#   the code the owner typed. Not for api, not for notifier, not for deriver.
# PRODUCTION: systemd credential on notchstave-settler.service, same rule as
#   ACCOUNT_XPUB and INVOICE_INTEGRITY_KEY.
NOTCHSTAVE_ADMIN_CONFIRMATION_KEY=placeholder-admin-key-local-dev-only

# --- Admin policy thresholds (TZ 3.4, 5.8/T7, T8) ----------------------------
# Versioned as a set: change any number below and bump ADMIN_POLICY_VERSION in
# the same edit. The version is written into audit_log and manual_reviews on
# every owner decision, and a threshold that moved without the version moving
# makes every earlier row a lie about what it meant (TZ 5.8/T8).
ADMIN_POLICY_VERSION=2026-08-17.admin-1
# Above this, `/resolve credit` requires the confirmation code.
ADMIN_MANUAL_CREDIT_LIMIT_USD=50
# Above this, `/reconcile` stops being a report and opens an incident. TZ
# section 7 calls a ledger/chain divergence the most serious thing that can
# happen; not zero, because dust on a receive address is drift by the
# arithmetic and not by the accounting.
ADMIN_RECONCILE_DRIFT_THRESHOLD_USD=1
# How long a confirmation code stays valid. Effective life is one to two
# windows, because the previous time bucket also verifies.
ADMIN_CONFIRMATION_TTL_SECONDS=300

# --- Money policy thresholds (TZ 5.5) ----------------------------------------
# Same versioning rule as above: SETTLER_POLICY_VERSION travels with the
# numbers into every settlement's audit row.
SETTLER_POLICY_VERSION=2026-08-15.settler-1
# Underpayment: the SMALLER of the two, because the tolerance exists to absorb
# an exchange withdrawal fee, not to discount the product.
SETTLER_UNDERPAY_TOLERANCE_PCT=0.005
SETTLER_UNDERPAY_TOLERANCE_CAP_USD=1
# Overpayment: the LARGER of the two, because it exists to avoid opening a
# refund case over dust.
SETTLER_OVERPAY_TOLERANCE_PCT=0.05
SETTLER_OVERPAY_TOLERANCE_FLOOR_USD=5

# --- Observability (TZ section 7/11, Week 4) ---------------------------------
# docker-compose.yml's grafana service. Local dev only, same rule as every
# other password in this file — production uses systemd credentials.
GRAFANA_ADMIN_PASSWORD=change-me-local-dev-only
# watcher.metrics.start_exporter / settler.metrics.start_exporter each bind
# their own port (TZ section 4: one process per chain, one registry per
# process — see settler/metrics.py::start_exporter for why they cannot share
# one). Defaults match watcher/config.py and settler/main.py; only listed here
# so a second watcher instance (a second chain) has an obvious second value to
# set instead of colliding with the first on 9102.
WATCHER_METRICS_PORT=9102
SETTLER_METRICS_PORT=9103
